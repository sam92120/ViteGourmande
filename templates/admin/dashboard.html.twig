<div class="card mt-5 shadow-sm">
    <div class="card-header">
        <h4 class="mb-0">
            <i class="fa-solid fa-ranking-star me-2"></i>
            Menus les plus consultés
        </h4>
    </div>

```
<div class="card-body">

    {% if topMenus is empty %}

        <p class="text-muted text-center mb-0">
            Aucune consultation de menu enregistrée pour le moment.
        </p>

    {% else %}

        {% for menu in topMenus %}

            <div class="top-menu-item mb-4">

                <div class="d-flex justify-content-between align-items-center mb-2">

                    <div>
                        <span class="badge bg-dark me-2">
                            #{{ loop.index }}
                        </span>

                        <strong>
                            {{ menu.menuTitle }}
                        </strong>
                    </div>

                    <span class="fw-bold">
                        {{ menu.count }} vue{% if menu.count > 1 %}s{% endif %}
                    </span>

                </div>

                <div class="progress" style="height: 10px;">
                    <div
                        class="progress-bar"
                        role="progressbar"
                        style="width: {{ menu.percentage }}%;"
                        aria-valuenow="{{ menu.percentage }}"
                        aria-valuemin="0"
                        aria-valuemax="100">
                    </div>
                </div>

            </div>

        {% endfor %}

    {% endif %}

</div>
```

</div>

<script>
document.addEventListener('DOMContentLoaded', function () {

    const canvas = document.getElementById('dailyViewsChart');

    if (!canvas) {
        return;
    }

    const dailyViews = {{ dailyViews|json_encode|raw }};

    const labels = dailyViews.map(function (item) {
        const date = new Date(item.date + 'T00:00:00');

        return date.toLocaleDateString('fr-FR', {
            day: '2-digit',
            month: '2-digit'
        });
    });

    const values = dailyViews.map(function (item) {
        return item.count;
    });

    new Chart(canvas, {
        type: 'line',

        data: {
            labels: labels,

            datasets: [{
                label: 'Consultations',
                data: values,

                borderWidth: 3,
                tension: 0.3,

                fill: true
            }]
        },

        options: {
            responsive: true,

            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        precision: 0
                    }
                }
            },

            plugins: {
                legend: {
                    display: true
                }
            }
        }
    });

});
</script>

