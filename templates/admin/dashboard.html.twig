{% extends '@EasyAdmin/page/content.html.twig' %}

{% block content_title %}
    <h1 class="title p-4">Espace Administrateur</h1>
{% endblock %}

{% block main %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="row g-4">

    <div class="col-md-3">
        <a href="{{ path('admin_commande_index') }}" class="text-decoration-none text-dark">
            <div class="card shadow-sm p-4 text-center" style="background-color: #8e8cf2; cursor:pointer;">
                <h5>Commandes</h5>
                <h2>{{ nbCommandes }}</h2>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="{{ path('admin_avis_index') }}" class="text-decoration-none text-dark">
            <div class="card shadow-sm p-4 text-center" style="background-color: #f28c8c; cursor:pointer;">
                <h5>Avis en attente</h5>
                <h2>{{ nbAvisEnAttente }}</h2>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="{{ path('admin_menu_index') }}" class="text-decoration-none text-dark">
            <div class="card shadow-sm p-4 text-center" style="background-color: #f0a500; cursor:pointer;">
                <h5>Menus</h5>
                <h2>{{ nbMenus }}</h2>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="{{ path('admin_plat_index') }}" class="text-decoration-none text-dark">
            <div class="card shadow-sm p-4 text-center" style="background-color: #62afb4; cursor:pointer;">
                <h5>Plats</h5>
                <h2>{{ nbPlats }}</h2>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a href="{{ path('admin_user_index') }}" class="text-decoration-none text-dark">
            <div class="card shadow-sm p-4 text-center" style="background-color: #679375; cursor:pointer;">
                <h5>Utilisateurs</h5>
                <h2>{{ nbUsers }}</h2>
            </div>
        </a>
    </div>

</div>

<div class="card mt-5 shadow-sm">
    <div class="card-header">
        <h4>Statistiques générales</h4>
    </div>
    <div class="card-body">
        <canvas id="statsChart" height="120" width="200"></canvas>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
    const ctx = document.getElementById('statsChart');

    new Chart(ctx, {
        type: 'bar',
        data: {
            labels: ['Menus', 'Plats', 'Commandes', 'Avis en attente', 'Utilisateurs'],
            datasets: [{
                label: 'Statistiques globales',
                data: [
                    {{ nbMenus }},
                    {{ nbPlats }},
                    {{ nbCommandes }},
                    {{ nbAvisEnAttente }},
                    {{ nbUsers }}
                    
                ],
                backgroundColor: 'rgba(255, 99, 132, 0.5)',
                borderColor: 'rgba(255, 99, 132, 1)',
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            scales: {
                y: {
                    beginAtZero: true
                }
            }
        }
    });
});
</script>
{% endblock %}