
<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Conditions Générales de Vente</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
</head>


<body>
    <nav class="navbar navbar-expand-lg navbar-light" style="background-color: #0B3D2E;">
        <a class="navbar-brand text-white" href="{{ path('app_accueil') }}">Vite Gourmande</a>
        <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <a class="nav-link text-white" href="{{ path('app_accueil') }}">Accueil</a>
                </li>
                
            </ul>
        </div>
    </nav>
<div class="container mt-5 border rounded shadow p-4 bg-white">
    <h1 class="mb-4">Notifications</h1> 
    {% for notification in notifications %}
        <div class="card mb-3">
            <div class="card-body">
                <h5 class="card-title">{{ notification.createdAt|date('d/m/Y H:i') }}</h5>
                <p class="card-text">{{ notification.message }}</p>
            </div>
        </div>
    {% else %}
        <p class="text-muted">Aucune notification.</p>
    {% endfor %}
</div>
</body>
</html>         