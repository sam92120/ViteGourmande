{% extends 'base.html.twig' %}

{% block title %}Réinitialiser votre mot de passe{% endblock %}

{% block body %}

<div class="container d-flex justify-content-center align-items-center mt-5">

    <div class="card shadow-lg border-0 rounded-4 p-5" style="width: 32rem;">

        <div class="text-center mb-4">

            <h1 class="fw-bold">
                Nouveau mot de passe
            </h1>

            <p class="text-muted mt-3">
                Choisissez un nouveau mot de passe sécurisé pour votre compte.
            </p>

        </div>

        {{ form_start(resetForm) }}

            <div class="mb-4">

                {{ form_label(resetForm.plainPassword.first, 'Nouveau mot de passe', {
                    label_attr: {
                        class: 'fw-semibold mb-2'
                    }
                }) }}

                {{ form_widget(resetForm.plainPassword.first, {
                    attr: {
                        class: 'form-control form-control-lg',
                        placeholder: 'Entrez votre mot de passe'
                    }
                }) }}

                {{ form_errors(resetForm.plainPassword.first) }}

            </div>

            <div class="mb-4">

                {{ form_label(resetForm.plainPassword.second, 'Confirmer le mot de passe', {
                    label_attr: {
                        class: 'fw-semibold mb-2'
                    }
                }) }}

                {{ form_widget(resetForm.plainPassword.second, {
                    attr: {
                        class: 'form-control form-control-lg',
                        placeholder: 'Confirmez votre mot de passe'
                    }
                }) }}

                {{ form_errors(resetForm.plainPassword.second) }}

            </div>

            <button class="btn btn-dark btn-lg w-100 rounded-3">
                Réinitialiser le mot de passe
            </button>

        {{ form_end(resetForm) }}

        <div class="text-center mt-4">

            <a href="{{ path('app_login') }}"
               class="text-decoration-none text-muted">

                ← Retour à la connexion

            </a>

        </div>

    </div>

</div>

{% endblock %}