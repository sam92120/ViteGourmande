{{ form_start(form) }}

<div class="row justify-content-center">

    <div class="col-md-6 mb-4">

        {% if form.datePretation is defined %}
            <div class="mb-3">
                {{ form_label(form.datePretation, 'Date de prestation', {
                    'label_attr': {
                        'class': 'form-label fw-bold'
                    }
                }) }}

                {{ form_widget(form.datePretation, {
                    'attr': {
                        'class': 'form-control'
                    }
                }) }}

                {{ form_errors(form.datePretation) }}
            </div>
        {% endif %}

        {% if form.heureLivraison is defined %}
            <div class="mb-3">
                {{ form_label(form.heureLivraison, 'Heure de livraison', {
                    'label_attr': {
                        'class': 'form-label fw-bold'
                    }
                }) }}

                {{ form_widget(form.heureLivraison, {
                    'attr': {
                        'class': 'form-control'
                    }
                }) }}

                {{ form_errors(form.heureLivraison) }}
            </div>
        {% endif %}

        {% if form.nbPers is defined %}
            <div class="mb-3">
                {{ form_label(form.nbPers, 'Nombre de personnes', {
                    'label_attr': {
                        'class': 'form-label fw-bold'
                    }
                }) }}

                {{ form_widget(form.nbPers, {
                    'attr': {
                        'class': 'form-control'
                    }
                }) }}

                {{ form_errors(form.nbPers) }}
            </div>
        {% endif %}

    </div>

</div>

<div class="text-center mt-4">
    <button class="btn btn-success px-5 py-2 rounded-3">
        {{ button_label|default('Enregistrer les modifications') }}
    </button>
</div>

{{ form_end(form, {'render_rest': false}) }}