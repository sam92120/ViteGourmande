{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}

 <!--retour accueil-->
<div class="d-flex justify-content-between align-items-center mb-4">
<a href="{{ path('app_accueil') }}" class="btn btn-light border">
    <i class="bi bi-arrow-left"></i>
    Retour à l'accueil
</a>
</div>
{# Bootstrap Icons #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container d-flex justify-content-center align-items-center mt-5">

    <div class="shadow-lg p-5 bg-light rounded" style="width: 40rem;">

        <form method="post" action="{{ path('app_login') }}">

            {# ERREUR LOGIN #}
            {% if error %}
                <div class="alert alert-danger">
                  identifiant ou mot de passe incorrect
                </div>
            {% endif %}

            {# USER CONNECTÉ #}
            {% if app.user %}
                <div class="mb-3">
                    Vous êtes connecté en tant que
                    <strong>{{ app.user.userIdentifier }}</strong>,
                    <a href="{{ logout_path() }}">Logout</a>
                </div>
            {% endif %}

            {# TITLE #}
            <h1 class="h3 mb-4 text-center">
                Connectez-vous
            </h1>

            {# EMAIL #}
            <div class="mb-3">

                <label for="inputEmail" class="form-label">
                    Email
                </label>

                <input
                    type="email"
                    value="{{ last_username }}"
                    name="email"
                    id="inputEmail"
                    class="form-control"
                    autocomplete="email"
                    required
                    autofocus
                >

            </div>

            {# PASSWORD #}
            <div class="mb-4">

                <label for="inputPassword" class="form-label">
                    Mot de passe
                </label>

                {# WRAPPER POSITION RELATIVE #}
                <div class="position-relative">

                    <input
                        type="password"
                        name="password"
                        id="inputPassword"
                        class="form-control pe-5"
                        autocomplete="current-password"
                        maxlength="4096"
                        minlength="6"
                        required
                    >

                    {# ICON OEIL #}
                    <i
                        class="bi bi-eye-slash"
                        id="togglePassword"
                        style="
                            position:absolute;
                            top:50%;
                            right:15px;
                            transform:translateY(-50%);
                            cursor:pointer;
                            font-size:20px;
                            text-shadow:0 0 2px rgba(0,0,0,0.3);
                        "
                    ></i>

                </div>

            </div>

            {# CSRF TOKEN #}
            <input
                type="hidden"
                name="_csrf_token"
                value="{{ csrf_token('authenticate') }}"
            >

            {# MOT DE PASSE OUBLIÉ #}
            <a
                href="{{ path('app_forgot_password_request') }}"
                class="text-decoration-none mb-3 d-block"
            >
                Mot de passe oublié ?
            </a>

            {# BUTTON LOGIN #}
            <button class="btn btn-dark w-100" type="submit">
                Se connecter
            </button>

        </form>
        <div class="text-center mt-3 border-top pt-3 text-start">
        <span>Pas de compte ?</span>
        <a href="{{ path('app_inscription') }}" class="text-decoration-none text-start">S'inscrire</a>
    </div>

    </div>
    
    </div>
    
</div>


{# SCRIPT PASSWORD #}
<script>

    const togglePassword = document.getElementById('togglePassword');

    const password = document.getElementById('inputPassword');

    togglePassword.addEventListener('click', function () {

        // Toggle type
        const type = password.getAttribute('type') === 'password'
            ? 'text'
            : 'password';

        password.setAttribute('type', type);

        // Toggle icon
        this.classList.toggle('bi-eye');
        this.classList.toggle('bi-eye-slash');

    });

</script>

{% endblock %}