{% extends 'base.html.twig' %}

{% block title %}Galerie des plats{% endblock %}

{% block body %}

 <a href="{{ path('app_accueil') }}" class="btn btn-light border">
            <i class="bi bi-arrow-left"></i>
            Retour à l'accueil
        </a>

<div class="container py-5">
<!--retour a la page d'accueil-->
    <div class="mb-4">
        
       
    </div>

    <h1 class="text-center mb-5 fw-bold text-dark">
        Tous nos plats disponibles
    </h1>

    <h2 class="mb-4 text-center text-success">Plats</h2>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center mb-5">
        {% for plat in platsPrincipaux %}
            <div class="col">
                <div class="card h-100 shadow menu-card">

                    {% if plat.photo %}
                        <img
                            src="{{ asset('uploads/plats/' ~ plat.photo) }}"
                            class="card-img-top image-menu shadow"
                            alt="{{ plat.titrePlat }}"
                        >
                    {% endif %}

                    <div class="card-body">
                        <h5 class="card-title">
                            {{ plat.titrePlat }}
                        </h5>

                        <p class="card-text">
                            {{ plat.description|default('Aucune description')|striptags|slice(0, 120) }}
                        </p>

                        <p>
                            <strong>Type :</strong> {{ plat.type }}
                        </p>
                    </div>

                </div>
            </div>
        {% else %}
            <p class="text-center text-muted">Aucun plat disponible.</p>
        {% endfor %}
    </div>

    <h2 class="mb-4 text-center text-success">Desserts</h2>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center mb-5">
        {% for plat in desserts %}
            <div class="col">
                <div class="card h-100 shadow menu-card">

                    {% if plat.photo %}
                        <img
                            src="{{ asset('uploads/plats/' ~ plat.photo) }}"
                            class="card-img-top image-menu shadow"
                            alt="{{ plat.titrePlat }}"
                        >
                    {% endif %}

                    <div class="card-body">
                        <h5 class="card-title">
                            {{ plat.titrePlat }}
                        </h5>

                        <p class="card-text">
                            {{ plat.description|default('Aucune description')|striptags|slice(0, 120) }}
                        </p>

                        <p>
                            <strong>Type :</strong> {{ plat.type }}
                        </p>
                    </div>

                </div>
            </div>
        {% else %}
            <p class="text-center text-muted">Aucun dessert disponible.</p>
        {% endfor %}
    </div>

    <h2 class="mb-4 text-center text-success">Entrées</h2>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 justify-content-center mb-5">
        {% for plat in entrees %}
            <div class="col">
                <div class="card h-100 shadow menu-card">

                    {% if plat.photo %}
                        <img
                            src="{{ asset('uploads/plats/' ~ plat.photo) }}"
                            class="card-img-top image-menu shadow"
                            alt="{{ plat.titrePlat }}"
                        >
                    {% endif %}

                    <div class="card-body">
                        <h5 class="card-title">
                            {{ plat.titrePlat }}
                        </h5>

                        <p class="card-text">
                            {{ plat.description|default('Aucune description')|striptags|slice(0, 120) }}
                        </p>

                        <p>
                            <strong>Type :</strong> {{ plat.type }}
                        </p>
                    </div>

                </div>
            </div>
        {% else %}
            <p class="text-center text-muted">Aucune entrée disponible.</p>
        {% endfor %}
    </div>

</div>

{% endblock %}