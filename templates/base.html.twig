<!DOCTYPE html>
<html>
    <head>
      
        <meta charset="UTF-8">
        <title>{% block title %}Vite&Gourmande{% endblock %}</title>
        <link rel="stylesheet" href="/css/style.css">
        <link rel="icon" href="/image/logovitegourmande.png">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
        {% block stylesheets %}
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}


    </head>
    <body >

    <header>        
<nav class="navbar  navbar-scrolled navbar-expand-lg bg-body-light text-light style="background-color: style="background-color: #0B3D2E;;">
  <div class="container-fluid  text-light  px-4 "> 
    <a class="navbar-brand  text-light " href="#">Vite&Gourmande</a>
     <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">

      <li class="nav-item mx-4">
           <!--ajouter redirection vers les pas administrateur et employe-->
        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('admin') }}" class="btn btn-light mt-3">Tableau de bord Admin</a>
        {% elseif is_granted('ROLE_EMPLOYEE') %}
            <a href="{{ path('employee') }}" class="btn btn-light mt-3">Tableau de bord Employé</a>
        {% endif %}
        </li>
      <ul class="navbar-nav  ms-auto mb-2 mb-lg-2">
         
        
        <li class="nav-item mx-4">
          <a class="nav-link text-light" aria-current="page" href="{{ path('app_accueil') }}">Accueil</a>
        </li>
        <li class="nav-item mx-4">
          <a class="nav-link text-light" href="{{ path('app_menu_index') }}"> Menus </a>
        </li>
        
        <li class="nav-item mx-4">
          <a class="nav-link text-light"  href="{{ path('app_plat_galerie') }}">  Galerie  </a>
        </li>
        <li class="nav-item mx-4">
          <a class="nav-link text-light" href="{{ path('app_moncompte') }}"> Mon  Compte</a>
        </li>
        {% if app.user %}
        <li class="nav-item mx-4">
          <a class="nav-link text-light" href="{{ path('app_logout') }}">Déconnexion</a>
        </li>
        {% else %}
        <li class="nav-item mx-4">
          <a class="nav-link text-light" href="{{ path('app_login') }}">Connexion</a>
        </li>
        <li class="nav-item mx-4">
          <a class="nav-link text-light" href="{{ path('app_inscription') }}">Inscription</a>
        </li>
        {% endif %}
        
      </ul>
      
    </div>
  </div>
</nav>
</header>


   <main class="flex-grow-1 pb-5">  
         <!-- ton contenu -->
                     {% block body %}{% endblock %}

    </main>


        <!-- pied de la page -->
        <footer class="colfooter  text-light  mt-5 text-md-start p-4 mt-auto  ">
        <div class="container-fluid p-4 ">
            <div class=" row flex-nowrap overflow-x-hidden"> 
                <div class="col mb-md-0 ">
                    <h5 class="text-uppercase">Information </h5>
                    <p>
                    <a href="{{ path('app_accueil') }}" class="text-light p-2 m-2">Accueil</a> <br>
                    <a href="{{ path('app_accueil') }}" class="text-light p-2 m-2">À propos</a>   <br>
                    <a href="{{ path('app_plat_galerie') }}" class="text-light p-2 m-2">Nos Plats</a> <br>
                    <a href="{{ path('app_contact') }}" class="text-light p-2 m-2">contact</a> 
              
                    </p>
                </div>
               <div class="col col-md-6 mb-4 mb-md-0 border-start barre-separatrice">

    <h5 class="text-uppercase">Horaires</h5>

    {% if horaires is defined %}

        {% for horaire in horaires %}

            <p class="mb-1 p-2">

                {{ horaire.jour }} :

                {% if horaire.estFerme %}

                    Fermé

                {% else %}

                    {{ horaire.heureOuverture|date('H:i') }}
                    à
                    {{ horaire.heureFermeture|date('H:i') }}

                {% endif %}

            </p>

        {% else %}

            <p class="mb-1 p-2">
                Aucun horaire renseigné.
            </p>

        {% endfor %}

    {% else %}

        <p class="mb-1 p-2">
            Horaires non disponibles.
        </p>

    {% endif %}

</div>
                <div class="col col-md-6 mb-4 mb-md-0 border-start barre-separatrice"> 
                    <h5 class="text-uppercase">Contactez-nous</h5>
                    <ul class="list-unstyled mb-0">
                        
                         <li>
                            <p><a class="bi bi-geo-alt p-2"></a> 123 Rue de la Cuisine, Bordeaux, France</p>
                        </li>
                       
                        <li>
                            <p><a class="bi bi-telephone p-2"></a> +33 1 23 45 67 89</p>
                        </li>
                      

                        <li>
                            <p><a class="bi bi-envelope p-2"></a> vitegourmandeadmin@gmail.com</p>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        
        <div class="container-fluid  p-3  text-light border-top  barre-separatrice ">
        <div class="row   ">
            <div class="col text-md-start">
                <p class="mb-0">&copy; 2024 Vite&Gourmande. Tous droits réservés.</p>
            </div>
            <div class="col text-md-end text-light">
                 <a href="{{ path('app_conditions_generales_de_vente') }}" class="text-light text-center me-2">Condition générale de vente</a>
            </div>
            <div class="col text-md-end">
                <a href="{{ path('app_politique_confidentiele') }}" class="text-light text-center me-2">Politique de confidentialité</a>  
            </div>
        </div>

    </footer>

    
    

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
    </body>
</html>
