<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Vite&Gourmande{% endblock %}</title>

    <link rel="icon" href="/image/logovitegourmande.png">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    {% block stylesheets %}{% endblock %}

    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>

<body>
<header>
    <nav class="navbar navbar-expand-lg text-light" style="background-color: #0B3D2E;">
        <div class="container-fluid px-4">
            <a class="navbar-brand text-light" href="{{ path('app_accueil') }}">Vite&Gourmande</a>

            <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}" class="btn btn-light ms-3">Tableau de bord Admin</a>
                {% elseif is_granted('ROLE_EMPLOYEE') %}
                    <a href="{{ path('employee') }}" class="btn btn-light ms-3">Tableau de bord Employé</a>
                {% endif %}

                <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                    <li class="nav-item mx-3">
                        <a class="nav-link text-light" href="{{ path('app_accueil') }}">Accueil</a>
                    </li>

                    <li class="nav-item mx-3">
                        <a class="nav-link text-light" href="{{ path('app_menu_index') }}">Menus</a>
                    </li>

                    <li class="nav-item mx-3">
                        <a class="nav-link text-light" href="{{ path('app_plat_galerie') }}">Galerie</a>
                    </li>

                    <li class="nav-item mx-3">
                        <a class="nav-link text-light" href="{{ path('app_moncompte') }}">Mon Compte</a>
                    </li>

                    {% if app.user %}
                        <li class="nav-item mx-3">
                            <a class="nav-link text-light" href="{{ path('app_logout') }}">Déconnexion</a>
                        </li>
                    {% else %}
                        <li class="nav-item mx-3">
                            <a class="nav-link text-light" href="{{ path('app_login') }}">Connexion</a>
                        </li>

                        <li class="nav-item mx-3">
                            <a class="nav-link text-light" href="{{ path('app_inscription') }}">Inscription</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>
</header>

<main class="flex-grow-1 pb-5">
    {% block body %}{% endblock %}
</main>

<footer class="colfooter text-light mt-5 p-4">
    <div class="container-fluid p-4">
        <div class="row">
            <div class="col">
                <h5 class="text-uppercase">Information</h5>
                <p>
                    <a href="{{ path('app_accueil') }}" class="text-light p-2 m-2">Accueil</a><br>
                    <a href="{{ path('app_accueil') }}" class="text-light p-2 m-2">À propos</a><br>
                    <a href="{{ path('app_plat_galerie') }}" class="text-light p-2 m-2">Nos Plats</a><br>
                    <a href="{{ path('app_contact') }}" class="text-light p-2 m-2">Contact</a>
                </p>
            </div>

            <div class="col border-start barre-separatrice">
                <h5 class="text-uppercase">Horaires</h5>

                {% if horaires is defined %}
                    {% for horaire in horaires %}
                        <p class="mb-1 p-2">
                            {{ horaire.jour }} :
                            {% if horaire.estFerme %}
                                Fermé
                            {% else %}
                                {{ horaire.heureOuverture|date('H:i') }}
                                à
                                {{ horaire.heureFermeture|date('H:i') }}
                            {% endif %}
                        </p>
                    {% else %}
                        <p class="mb-1 p-2">Aucun horaire renseigné.</p>
                    {% endfor %}
                {% else %}
                    <p class="mb-1 p-2">Horaires non disponibles.</p>
                {% endif %}
            </div>

            <div class="col border-start barre-separatrice">
                <h5 class="text-uppercase">Contactez-nous</h5>
                <ul class="list-unstyled mb-0">
                    <li><p><i class="bi bi-geo-alt p-2"></i>123 Rue de la Cuisine, Bordeaux, France</p></li>
                    <li><p><i class="bi bi-telephone p-2"></i>+33 1 23 45 67 89</p></li>
                    <li><p><i class="bi bi-envelope p-2"></i>vitegourmandeadmin@gmail.com</p></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="container-fluid p-3 text-light border-top barre-separatrice">
        <div class="row">
            <div class="col">
                <p class="mb-0">&copy; 2024 Vite&Gourmande. Tous droits réservés.</p>
            </div>

            <div class="col text-md-end">
                <a href="{{ path('app_conditions_generales_de_vente') }}" class="text-light me-2">
                    Condition générale de vente
                </a>
            </div>

            <div class="col text-md-end">
                <a href="{{ path('app_politique_confidentiele') }}" class="text-light me-2">
                    Politique de confidentialité
                </a>
            </div>
        </div>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>