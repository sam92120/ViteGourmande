{% extends 'base.html.twig' %}

{% block title %}Détail de l'avis{% endblock %}

{% block body %}

<div class="container my-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <div class="card-header text-white p-4" style="background-color: #0B3D2E;">

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">

                        <div>
                            <h1 class="h3 mb-1">Mon avis</h1>

                            <p class="mb-0 opacity-75">
                                Avis n°{{ avi.id }}
                            </p>
                        </div>

                        <span class="
                            badge px-3 py-2
                            {% if avi.status %}
                                bg-success
                            {% else %}
                                bg-warning text-dark
                            {% endif %}
                        ">
                            {% if avi.status %}
                                Validé
                            {% else %}
                                En attente
                            {% endif %}
                        </span>

                    </div>

                </div>

                <div class="card-body p-5 bg-light">

                    <div class="mb-4 text-center">

                        {% for i in 1..5 %}

                            {% if i <= avi.note %}
                                <i class="fa-solid fa-star text-warning fs-3"></i>
                            {% else %}
                                <i class="fa-regular fa-star text-warning fs-3"></i>
                            {% endif %}

                        {% endfor %}

                    </div>

                    <div class="bg-white rounded-4 shadow-sm p-4">

                        <h5 class="fw-bold mb-3">
                            Commentaire
                        </h5>

                        <p class="text-muted mb-0">
                            {{ avi.commentaire|default('Aucun commentaire.') }}
                        </p>

                    </div>

                </div>

                <div class="card-footer bg-white p-4 d-flex justify-content-between flex-wrap gap-2">

                    <a
                        href="{{ path('app_avis_index') }}"
                        class="btn btn-outline-secondary rounded-3"
                    >
                        ← Retour à la liste
                    </a>

                    <div class="d-flex gap-2">

                        <a
                            href="{{ path('app_avis_edit', {'id': avi.id}) }}"
                            class="btn btn-outline-primary rounded-3"
                        >
                            Modifier
                        </a>

                        {{ include('avis/_delete_form.html.twig') }}

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

{% endblock %}