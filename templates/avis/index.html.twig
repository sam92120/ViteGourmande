{% extends 'base.html.twig' %}

{% block title %}Mes avis{% endblock %}

{% block body %}

<div class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1">Mes avis</h1>
            <p class="text-muted mb-0">
                Retrouvez tous les avis que vous avez laissés.
            </p>
        </div>

        <a href="{{ path('app_avis_new') }}" class="btn btn-success rounded-3 px-4">
            + Laisser un avis
        </a>
    </div>

    {% if avis is empty %}

        <div class="alert alert-info shadow-sm rounded-4">
            Vous n’avez encore laissé aucun avis.
        </div>

    {% else %}

        <div class="row g-4">

            {% for avi in avis %}

                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4">

                        <div class="card-body d-flex flex-column">

                            <div class="d-flex justify-content-between align-items-center mb-3">

                                <span class="badge bg-dark">
                                    Avis #{{ avi.id }}
                                </span>

                                <span class="
                                    badge
                                    {% if avi.status %}
                                        bg-success
                                    {% else %}
                                        bg-warning text-dark
                                    {% endif %}
                                ">
                                    {% if avi.status %}
                                        Validé
                                    {% else %}
                                        En attente
                                    {% endif %}
                                </span>

                            </div>

                            <div class="mb-3">

                                {% for i in 1..5 %}

                                    {% if i <= avi.note %}
                                        <i class="fa-solid fa-star text-warning"></i>
                                    {% else %}
                                        <i class="fa-regular fa-star text-warning"></i>
                                    {% endif %}

                                {% endfor %}

                            </div>

                            <p class="text-muted flex-grow-1">
                                {{ avi.commentaire|default('Aucun commentaire') }}
                            </p>

                            <div class="d-flex gap-2 mt-3">

                                <a
                                    href="{{ path('app_avis_show', {'id': avi.id}) }}"
                                    class="btn btn-outline-primary btn-sm w-50"
                                >
                                    Voir
                                </a>

                                <a
                                    href="{{ path('app_avis_edit', {'id': avi.id}) }}"
                                    class="btn btn-outline-secondary btn-sm w-50"
                                >
                                    Modifier
                                </a>

                            </div>

                        </div>

                    </div>

                </div>

            {% endfor %}

        </div>

    {% endif %}

</div>

{% endblock %}